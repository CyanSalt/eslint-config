{
  "name": "@cyansalt/eslint-config",
  "version": "4.6.0",
  "description": "My ESLint configuration preset",
  "type": "module",
  "main": "index.js",
  "scripts": {
    "release": "release-it",
    "lint": "eslint --fix .",
    "lint:ci": "eslint --max-warnings 0 .",
    "test": "eslint ./tests"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/CyanSalt/eslint-config.git"
  },
  "bugs": {
    "url": "https://github.com/CyanSalt/eslint-config/issues"
  },
  "homepage": "https://github.com/CyanSalt/eslint-config#readme",
  "keywords": [
    "eslint",
    "eslintconfig"
  ],
  "author": "CyanSalt",
  "license": "ISC",
  "devEngines": {
    "runtime": {
      "name": "node",
      "version": "^24.15.0",
      "onFail": "error"
    },
    "packageManager": [
      {
        "name": "pnpm",
        "version": "^11.0.0",
        "onFail": "ignore"
      },
      {
        "name": "npm",
        "onFail": "ignore"
      }
    ]
  },
  "devDependencies": {
    "@release-it/conventional-changelog": "^12.0.2",
    "@types/node": "^24.12.3",
    "@types/semver": "^7.8.0",
    "eslint": "^10.15.0",
    "release-it": "^21.1.2",
    "type-fest": "^5.6.0",
    "typescript": "^6.0.3",
    "vue": "^3.5.45"
  },
  "dependencies": {
    "@eslint/js": "^10.0.1",
    "@stylistic/eslint-plugin": "^6.0.1",
    "@typescript-eslint/parser": "^8.73.0",
    "eslint-config-flat-gitignore": "^2.4.0",
    "eslint-flat-config-utils": "^3.2.0",
    "eslint-import-resolver-alias": "^1.1.2",
    "eslint-import-resolver-typescript": "^4.4.5",
    "eslint-plugin-galaxy": "^2.1.0",
    "eslint-plugin-import-x": "^4.18.1",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-unicorn": "^80.0.0",
    "eslint-plugin-vue": "^10.12.1",
    "eslint-plugin-vue-scoped-css": "^3.1.3",
    "globals": "^17.14.0",
    "local-pkg": "^2.0.0",
    "semver": "^7.8.6",
    "typescript-eslint": "^8.73.0",
    "vue-eslint-parser": "^10.4.2"
  },
  "peerDependencies": {
    "eslint": ">=9.27.0",
    "typescript": ">=2.9.0"
  },
  "peerDependenciesMeta": {
    "typescript": {
      "optional": true
    }
  }
}
